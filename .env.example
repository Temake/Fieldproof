# ---- Runtime mode -----------------------------------------------------------
# local  = in-memory store, filesystem object store, in-process event bus
# aws    = DynamoDB + S3 + EventBridge
FIELDPROOF_MODE=local

# ---- Local adapters ---------------------------------------------------------
FIELDPROOF_DATA_DIR=./.fieldproof-data
FIELDPROOF_OBJECT_DIR=./.fieldproof-data/objects

# ---- AWS (only needed when FIELDPROOF_MODE=aws) ------------------------------
AWS_REGION=us-east-1
FIELDPROOF_TABLE_NAME=fieldproof
FIELDPROOF_BUCKET_NAME=fieldproof-evidence
FIELDPROOF_EVENT_BUS=fieldproof-bus

# ---- Models -----------------------------------------------------------------
# Multimodal model used by the Evidence Agent (images, receipts, audio context).
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_REGION=us-east-1

# Set to 1 to run agents against deterministic stub extractors instead of a
# real model. Required for offline tests and CI. Set to 0 to read artifacts
# through Bedrock (needs AWS credentials with access to BEDROCK_MODEL_ID).
FIELDPROOF_STUB_AGENTS=1

# ---- Orchestrator -----------------------------------------------------------
# inprocess = the deterministic sequencer in agents/orchestrator/graph.py
# strands   = the same steps as a Strands multi-agent graph (AgentCore path)
FIELDPROOF_ORCHESTRATOR=inprocess

# ---- Web --------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- API security (PRD 34) ---------------------------------------------------
# When set, every /api route requires "Authorization: Bearer <key>".
FIELDPROOF_API_KEY=
# Signs local upload URLs. Leave empty for a random per-process secret.
FIELDPROOF_SIGNING_SECRET=
FIELDPROOF_MAX_UPLOAD_MB=20
FIELDPROOF_UPLOAD_URL_TTL=900
# Base URL the API is reachable at - used to build local signed upload URLs.
FIELDPROOF_PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated origins allowed by CORS.
FIELDPROOF_CORS_ORIGINS=http://localhost:3000
